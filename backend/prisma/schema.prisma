generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ActivityLog {
  id        String         @id @default(uuid())
  action    ActivityAction
  metadata  Json?
  createdAt DateTime       @default(now())
  taskId    String
  actorId   String
  User      User           @relation(fields: [actorId], references: [id])
  Task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([actorId])
  @@index([taskId, createdAt])
}

model Bid {
  id            String    @id @default(uuid())
  amount        Float
  coverLetter   String
  estimatedDays Int
  smartScore    Float     @default(0)
  status        BidStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  freelancerId  String
  taskId        String
  teamId        String?
  User          User      @relation(fields: [freelancerId], references: [id])
  Task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  Team          Team?     @relation(fields: [teamId], references: [id])

  @@unique([freelancerId, taskId])
  @@index([freelancerId])
  @@index([status])
  @@index([taskId])
}

model ChatRequest {
  id                                String            @id @default(uuid())
  status                            ChatRequestStatus @default(PENDING)
  createdAt                         DateTime          @default(now())
  senderId                          String
  receiverId                        String
  User_ChatRequest_receiverIdToUser User              @relation("ChatRequest_receiverIdToUser", fields: [receiverId], references: [id])
  User_ChatRequest_senderIdToUser   User              @relation("ChatRequest_senderIdToUser", fields: [senderId], references: [id])

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Conversation {
  id                              String    @id @default(uuid())
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt
  user1Id                         String
  user2Id                         String
  User_Conversation_user1IdToUser User      @relation("Conversation_user1IdToUser", fields: [user1Id], references: [id])
  User_Conversation_user2IdToUser User      @relation("Conversation_user2IdToUser", fields: [user2Id], references: [id])
  Message                         Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  createdAt      DateTime     @default(now())
  read           Boolean      @default(false)
  senderId       String
  conversationId String
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  userId    String
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model ProjectMessage {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
  taskId    String
  senderId  String
  User      User     @relation(fields: [senderId], references: [id])
  Task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([taskId, createdAt])
}

model Review {
  id                           String   @id @default(uuid())
  rating                       Int
  comment                      String?
  createdAt                    DateTime @default(now())
  reviewerId                   String
  revieweeId                   String
  taskId                       String   @unique
  User_Review_revieweeIdToUser User     @relation("Review_revieweeIdToUser", fields: [revieweeId], references: [id])
  User_Review_reviewerIdToUser User     @relation("Review_reviewerIdToUser", fields: [reviewerId], references: [id])
  Task                         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Submission {
  id           String     @id @default(uuid())
  content      String
  link         String?
  submittedAt  DateTime   @default(now())
  freelancerId String
  taskId       String     @unique
  User         User       @relation(fields: [freelancerId], references: [id])
  Task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  WorkPart     WorkPart[]
}

model Task {
  id             String           @id @default(uuid())
  title          String
  description    String
  budget         Float
  requiredSkills String[]         @default([])
  status         TaskStatus       @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  clientId       String
  assignedToId   String?
  deletedAt      DateTime?
  primaryBidId   String?
  standbyBidId   String?
  ActivityLog    ActivityLog[]
  Bid            Bid[]
  ProjectMessage ProjectMessage[]
  Review         Review?
  Submission     Submission?
  User           User             @relation(fields: [clientId], references: [id])
  WorkPart       WorkPart[]

  @@index([clientId])
  @@index([createdAt])
  @@index([status])
}

model Team {
  id          String       @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String
  Bid         Bid[]
  User        User         @relation(fields: [createdById], references: [id])
  teamMembers TeamMember[]

  @@index([createdById])
}

model TeamMember {
  id       String   @id @default(uuid())
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())
  teamId   String
  userId   String
  Team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  User     User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

model User {
  id                                       String           @id @default(uuid())
  email                                    String           @unique
  name                                     String
  password                                 String?
  role                                     Role
  skills                                   String[]         @default([])
  bio                                      String?
  avgRating                                Float            @default(0)
  totalReviews                             Int              @default(0)
  createdAt                                DateTime         @default(now())
  updatedAt                                DateTime         @updatedAt
  googleId                                 String?          @unique
  deletedAt                                DateTime?
  isVerified                               Boolean          @default(false)
  verificationExpires                      DateTime?
  verificationToken                        String?          @unique
  avatarUrl                                String?
  ActivityLog                              ActivityLog[]
  Bid                                      Bid[]
  ChatRequest_ChatRequest_receiverIdToUser ChatRequest[]    @relation("ChatRequest_receiverIdToUser")
  ChatRequest_ChatRequest_senderIdToUser   ChatRequest[]    @relation("ChatRequest_senderIdToUser")
  Conversation_Conversation_user1IdToUser  Conversation[]   @relation("Conversation_user1IdToUser")
  Conversation_Conversation_user2IdToUser  Conversation[]   @relation("Conversation_user2IdToUser")
  Message                                  Message[]
  Notification                             Notification[]
  ProjectMessage                           ProjectMessage[]
  Review_Review_revieweeIdToUser           Review[]         @relation("Review_revieweeIdToUser")
  Review_Review_reviewerIdToUser           Review[]         @relation("Review_reviewerIdToUser")
  Submission                               Submission[]
  Task                                     Task[]
  Team                                     Team[]
  TeamMember                               TeamMember[]
  WorkFile                                 WorkFile[]
  WorkSubmission                           WorkSubmission[]

  @@index([role])
}

model WorkFile {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  uploadedAt   DateTime @default(now())
  workPartId   String
  uploaderId   String
  User         User     @relation(fields: [uploaderId], references: [id])
  WorkPart     WorkPart @relation(fields: [workPartId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@index([workPartId])
}

model WorkPart {
  id             String           @id @default(uuid())
  partNumber     Int
  title          String
  description    String
  status         WorkPartStatus   @default(NOT_STARTED)
  content        String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  feedback       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  submissionId   String?
  taskId         String?
  order          Int
  WorkFile       WorkFile[]
  Submission     Submission?      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  Task           Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  WorkSubmission WorkSubmission[]

  @@unique([submissionId, partNumber])
  @@unique([taskId, partNumber])
  @@index([status])
  @@index([taskId])
}

model WorkSubmission {
  id            String           @id @default(uuid())
  description   String
  status        SubmissionStatus @default(SUBMITTED)
  submittedBy   String
  submittedAt   DateTime         @default(now())
  reviewedAt    DateTime?
  reviewComment String?
  workPartId    String
  User          User             @relation(fields: [submittedBy], references: [id])
  WorkPart      WorkPart         @relation(fields: [workPartId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([submittedBy])
  @@index([workPartId])
}

enum ActivityAction {
  MILESTONE_CREATED
  MILESTONE_UPDATED
  MILESTONE_COMPLETED
  FILE_UPLOADED
  WORK_SUBMITTED
  WORK_APPROVED
  REVISION_REQUESTED
  MESSAGE_SENT
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  STANDBY
}

enum ChatRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum Role {
  CLIENT
  FREELANCER
}

enum SubmissionStatus {
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

enum TaskStatus {
  OPEN
  ASSIGNED
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TeamRole {
  LEADER
  MEMBER
}

enum WorkPartStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REVISION_REQUIRED
}
